# =============================================================
# TEMPLATE .env untuk lokal (development)
# JANGAN commit file .env asli ke GitHub!
# =============================================================

# Server
PORT=5000
NODE_ENV=development

# Database MySQL (lokal dengan XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=concert_db

# JWT — WAJIB diisi dengan string acak yang panjang dan unik
# Generate: node -e "require('crypto').randomBytes(64).then(b => console.log(b.toString('hex')))"
JWT_SECRET=your_jwt_secret_here_ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d

# Google Cloud SQL — hanya aktif di production/Cloud Run
# Format: PROJECT_ID:REGION:INSTANCE_NAME
# Contoh: my-project:us-central1:concert-db-instance
# INSTANCE_CONNECTION_NAME=your-project-id:us-central1:concert-db-instance

# CORS — batasi domain yang boleh akses API ini
# Di lokal biarkan kosong (default '*')
# Di production isi dengan domain frontend: https://fe-admin-concert.web.app
# CORS_ORIGIN=https://fe-admin-concert.web.app
